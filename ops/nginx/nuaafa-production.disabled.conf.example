# DISABLED CANDIDATE ONLY. HUMAN REVIEW, TLS PROVISIONING, AND nginx -t ARE REQUIRED.
# This template assumes exactly one public Nginx hop in front of a loopback-only app.
# It intentionally does not guess a Cloudflare or multi-proxy trust chain.
# Install within the http context; this file remains a disabled example.
limit_req_zone $binary_remote_addr zone=nuaafa_auth:10m rate=2r/s;

server {
    listen 80;
    listen [::]:80;
    server_name nuaafa.cn www.nuaafa.cn;
    return 301 https://nuaafa.cn$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name nuaafa.cn;

    ssl_certificate /etc/letsencrypt/live/nuaafa.cn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/nuaafa.cn/privkey.pem;

    # App contract: PDF <= 20 MiB; complete request <= 21 MiB.
    client_max_body_size 25m;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options SAMEORIGIN always;

    # Small public/auth forms have a separate budget from authorized uploads.
    location ~ ^/api/referees/(?:admin/)?(?:login|admission-applications|account/password)$ {
        client_max_body_size 16k;
        limit_req zone=nuaafa_auth burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;

        # Single trusted proxy contract: overwrite, never append client input.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
