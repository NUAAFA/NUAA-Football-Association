# /etc/systemd/system/nuaafa-ops-monitor.service
[Unit]
Description=NUAAFA read-only website and host monitoring
After=network-online.target
OnFailure=nuaafa-ops-event@nuaafa-ops-monitor.service

[Service]
Type=oneshot
User=nuaafa
Group=nuaafa
ExecStart=/usr/bin/python3 -I -B /usr/local/lib/nuaafa-post-launch/monitor.py
StateDirectory=nuaafa-ops-monitor
StateDirectoryMode=0700
UMask=0077
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/srv/nuaafa/shared /var/lib/nuaafa-ops-backup
InaccessiblePaths=/srv/nuaafa/shared/.env.production /etc/nuaafa /srv/nuaafa/prebuilt
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
Nice=15
IOSchedulingClass=idle
CPUQuota=10%
MemoryMax=128M
TasksMax=16
TimeoutStartSec=45
Restart=no