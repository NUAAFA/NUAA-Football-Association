#!/usr/bin/env bash
set -Eeuo pipefail

deployer_version="R1-3D-FIX-3B-1"
repository="git@github-nuaafa:togatakeoff777-gif/NUAA-Football-Association.git"
release_root="/srv/nuaafa/releases"
shared="/srv/nuaafa/shared"
current_link="/srv/nuaafa/current"
deploy_user="nuaafa"
service_name="nuaafa.service"
db_backup_command="/usr/local/sbin/nuaafa-db-backup"
student_id_preflight_command="/usr/local/lib/nuaafa/student-id-release-preflight.mjs"
student_id_preflight_node="/usr/bin/node"
lock_file="/run/lock/nuaafa-deploy.lock"
default_allowed_ref="refs/heads/main"
provenance_name="nuaafa-staged-release.v1"

operation_mode="full"
mode_selected=false
dry_run=false
requested_commit=""
allowed_ref="$default_allowed_ref"
show_help=false
show_version=false

die() {
  echo "STOP: $*" >&2
  return 1
}

usage_error() {
  echo "Usage: nuaafa-deploy [--dry-run] [--allowed-ref refs/heads/BRANCH] [--stage-only|--activate-staged] [40-character-commit]" >&2
  return 2
}

usage() {
  cat <<'EOF'
Usage: nuaafa-deploy [--dry-run] [--allowed-ref refs/heads/BRANCH] [--stage-only|--activate-staged] [40-character-commit]

Modes:
  default             Legacy full deploy: prepare, backup, migrate, build,
                      switch current, restart, and verify health.
  --stage-only        Prepare and build an exact release without DB, current,
                      service, content, upload, environment, or timer mutation.
  --activate-staged   Verify and atomically switch to a staged release only.

Stage-only and activate-staged require an explicit 40-character commit.
The allowed ref defaults to refs/heads/main; R1-3D feature staging must pass its
reviewed refs/heads/... value explicitly.
EOF
}

select_mode() {
  local requested_mode="$1"
  if [ "$mode_selected" = true ]; then
    die "conflicting deployment modes"
    return 2
  fi
  operation_mode="$requested_mode"
  mode_selected=true
}

parse_args() {
  operation_mode="full"
  mode_selected=false
  dry_run=false
  requested_commit=""
  allowed_ref="$default_allowed_ref"
  show_help=false
  show_version=false

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --dry-run)
        dry_run=true
        ;;
      --stage-only)
        select_mode "stage" || return $?
        ;;
      --activate-staged)
        select_mode "activate" || return $?
        ;;
      --allowed-ref)
        shift
        if [ "$#" -eq 0 ]; then
          usage_error
          return $?
        fi
        allowed_ref="$1"
        ;;
      --version)
        show_version=true
        ;;
      -h|--help)
        show_help=true
        ;;
      -*)
        echo "Unknown option: $1" >&2
        usage_error
        return $?
        ;;
      *)
        if [ -n "$requested_commit" ]; then
          echo "Only one commit may be specified." >&2
          usage_error
          return $?
        fi
        requested_commit="$1"
        ;;
    esac
    shift
  done

  if { [ "$operation_mode" = "stage" ] || [ "$operation_mode" = "activate" ]; } && [ -z "$requested_commit" ]; then
    echo "An exact commit is required for $operation_mode mode." >&2
    usage_error
    return $?
  fi
}

require_root() {
  if [ "${EUID:-$(id -u)}" -ne 0 ]; then
    die "run this command as root"
  fi
}

prepare_process() {
  umask 077
  cd /
}

acquire_lock() {
  exec 9>"$lock_file"
  flock -n 9 || die "another NUAAFA deployment is already running"
}

run_as_deploy_user() {
  runuser -u "$deploy_user" -- "$@"
}

set_link_owner() {
  chown -h "$deploy_user:$deploy_user" "$@"
}

set_file_owner() {
  chown "$deploy_user:$deploy_user" "$@"
}

verify_release_owner() {
  [ "$(stat -c '%U' "$1")" = "$deploy_user" ] || die "release path is not owned by $deploy_user: $1"
}

run_release_static_checks() {
  local release="$1"
  run_as_deploy_user bash -lc "set -e; cd '$release'; npm ci; npm run lint; npm run check:unicode; npm run test:referee-flow; npm audit --omit=dev --audit-level=critical; npx prisma generate; npx prisma validate"
}

run_release_build() {
  local release="$1"
  run_as_deploy_user bash -lc "set -e; cd '$release'; npm run build; test -f .next/BUILD_ID"
}

run_db_backup() {
  "$db_backup_command"
}

run_student_id_preflight() {
  local report
  validate_canonical_shared_file "$shared/prisma/dev.db" "production database"
  [ -f "$student_id_preflight_command" ] && ! path_is_symlink "$student_id_preflight_command" || die "installed student ID preflight is missing or unsafe"
  report="$(run_as_deploy_user env -i "$student_id_preflight_node" "$student_id_preflight_command" "--database=$shared/prisma/dev.db")" || die "student ID release preflight blocked release"
  if ! run_as_deploy_user env -i "$student_id_preflight_node" --input-type=module - "$report" <<'NODE'
const keys = ['totalReferees', 'totalActiveAccounts', 'missingStudentId', 'activeMissingStudentId', 'activeNonNormalizedStudentId', 'duplicateStudentIdGroups', 'unsafeLoginMigrationBlockers', 'scanComplete', 'readOnlyVerified', 'releaseAllowed'];
try {
  const r = JSON.parse(process.argv[2]);
  if (!r || Object.keys(r).length !== keys.length || !keys.every(k => Number.isSafeInteger(r[k]) && r[k] >= 0) ||
      r.scanComplete !== 1 || r.readOnlyVerified !== 1 || r.releaseAllowed !== 1 || r.unsafeLoginMigrationBlockers !== 0 ||
      r.unsafeLoginMigrationBlockers !== r.activeMissingStudentId + r.activeNonNormalizedStudentId + r.duplicateStudentIdGroups ||
      r.totalActiveAccounts > r.totalReferees || r.missingStudentId > r.totalReferees ||
      r.activeMissingStudentId > r.missingStudentId || r.activeMissingStudentId > r.totalActiveAccounts ||
      r.activeNonNormalizedStudentId > r.totalActiveAccounts) process.exit(1);
} catch { process.exit(1); }
NODE
  then
    die "student ID release preflight output is unverifiable"
  fi
  printf '%s\n' "$report"
}

run_migration() {
  local release="$1"
  run_as_deploy_user bash -lc "set -e; cd '$release'; DOTENV_CONFIG_PATH=.env.production npx prisma migrate deploy"
}

restart_service() {
  systemctl restart "$service_name"
}

wait_for_health() {
  local healthy=false
  local attempt
  for attempt in $(seq 1 20); do
    if curl --fail --silent --show-error --max-time 5 http://127.0.0.1:3001/api/health >/dev/null; then
      healthy=true
      break
    fi
    sleep 1
  done
  [ "$healthy" = true ]
}

# Keep filesystem link operations behind small primitives. Production uses the
# native tools below; the isolated Windows test harness replaces only these
# primitives because Git for Windows emulates links without a readable target.
path_is_symlink() {
  [ -L "$1" ]
}

read_symlink_target() {
  readlink -- "$1"
}

resolve_existing_path() {
  readlink -f -- "$1"
}

create_symlink() {
  ln -s -- "$1" "$2"
}

atomic_replace_path() {
  mv -T -- "$1" "$2"
}

is_exact_commit() {
  [[ "$1" =~ ^[0-9a-f]{40}$ ]]
}

validate_allowed_ref() {
  local ref="$1"
  [[ "$ref" =~ ^refs/heads/[A-Za-z0-9][A-Za-z0-9._/-]*$ ]] || die "allowed ref must be an explicit refs/heads/... value"
  [[ "$ref" != *".."* && "$ref" != *"//"* && "$ref" != */ && "$ref" != *"@{"* && "$ref" != *\\* ]] || die "allowed ref contains an unsafe sequence"
}

validate_fixed_configuration() {
  case "$repository" in
    *$'\n'*|*$'\r'*) die "repository contains a newline" ;;
  esac
  [[ "$release_root" = /* && "$shared" = /* && "$current_link" = /* ]] || die "deployment paths must be absolute"
  [ "$(dirname -- "$current_link")" = "$(dirname -- "$release_root")" ] || die "current and releases must share the approved parent"
}

validate_exact_directory() {
  local directory="$1"
  local label="$2"
  [ -d "$directory" ] || die "$label is not a directory: $directory"
  ! path_is_symlink "$directory" || die "$label must not be a symlink: $directory"
  [ "$(resolve_existing_path "$directory")" = "$directory" ] || die "$label path is not canonical: $directory"
}

validate_layout_roots() {
  validate_exact_directory "$release_root" "release root"
  validate_exact_directory "$(dirname -- "$current_link")" "current parent"
}

release_path_for() {
  printf '%s/%s\n' "$release_root" "$1"
}

validate_release_directory() {
  local release="$1"
  local commit="$2"
  is_exact_commit "$commit" || die "release commit is not exact"
  [ "$release" = "$(release_path_for "$commit")" ] || die "release path does not match the requested commit"
  [ "$(dirname -- "$release")" = "$release_root" ] || die "release is not a direct child of the release root"
  [ "$(basename -- "$release")" = "$commit" ] || die "release directory name does not match the commit"
  [ -d "$release" ] || die "release directory is missing: $release"
  ! path_is_symlink "$release" || die "release directory must not be a symlink: $release"
  [ "$(resolve_existing_path "$release")" = "$release" ] || die "release directory escapes the release root"
  verify_release_owner "$release"
  [ -d "$release/.git" ] || die "release Git directory is missing"
  ! path_is_symlink "$release/.git" || die "release Git directory must not be a symlink"
}

validate_preparation_directory() {
  local directory="$1"
  [ "$(dirname -- "$directory")" = "$release_root" ] || die "preparation directory is outside the release root"
  [ -d "$directory" ] || die "preparation directory is missing"
  ! path_is_symlink "$directory" || die "preparation directory must not be a symlink"
  [ "$(resolve_existing_path "$directory")" = "$directory" ] || die "preparation directory escapes the release root"
  verify_release_owner "$directory"
  [ -d "$directory/.git" ] && ! path_is_symlink "$directory/.git" || die "preparation Git directory is unsafe"
}

git_in_release() {
  local release="$1"
  shift
  run_as_deploy_user git -C "$release" "$@"
}

validate_origin() {
  local release="$1"
  local origin
  origin="$(git_in_release "$release" remote get-url origin)"
  [ "$origin" = "$repository" ] || die "release origin differs from the approved repository"
}

validate_git_state() {
  local release="$1"
  local commit="$2"
  local head
  local status
  head="$(git_in_release "$release" rev-parse HEAD)"
  [ "$head" = "$commit" ] || die "release HEAD differs from the requested commit"
  status="$(git_in_release "$release" status --porcelain)"
  [ -z "$status" ] || die "release Git worktree is not clean"
}

remote_ref_head() {
  local ref="$1"
  local output
  local line_count
  local head
  output="$(run_as_deploy_user git ls-remote --heads "$repository" "$ref")"
  line_count="$(printf '%s\n' "$output" | sed '/^$/d' | wc -l | tr -d ' ')"
  [ "$line_count" = "1" ] || die "allowed remote ref did not resolve exactly once: $ref"
  head="$(printf '%s\n' "$output" | awk 'NF >= 2 {print $1}')"
  is_exact_commit "$head" || die "allowed remote ref did not resolve to an exact commit"
  printf '%s\n' "$head"
}

fetched_remote_head=""
fetch_and_verify_reachability() {
  local release="$1"
  local commit="$2"
  local ref="$3"
  git_in_release "$release" fetch --no-tags origin "$ref"
  fetched_remote_head="$(git_in_release "$release" rev-parse FETCH_HEAD)"
  is_exact_commit "$fetched_remote_head" || die "fetched allowed ref is not an exact commit"
  git_in_release "$release" cat-file -e "${commit}^{commit}" || die "requested commit was not obtained from the approved repository"
  git_in_release "$release" merge-base --is-ancestor "$commit" "$fetched_remote_head" || die "requested commit is not reachable from the allowed remote ref"
}

validate_canonical_shared_file() {
  local file="$1"
  local label="$2"
  [ -f "$file" ] || die "$label is not a regular file: $file"
  ! path_is_symlink "$file" || die "$label must not be a symlink: $file"
  [ "$(resolve_existing_path "$file")" = "$file" ] || die "$label path is not canonical: $file"
}

verify_expected_link() {
  local entry="$1"
  local target="$2"
  local label="$3"
  path_is_symlink "$entry" || die "$label entry is not a symlink"
  [ "$(read_symlink_target "$entry")" = "$target" ] || die "$label link does not directly target the canonical path"
  [ "$(resolve_existing_path "$entry")" = "$target" ] || die "$label link resolves outside the canonical target"
}

ensure_expected_link() {
  local entry="$1"
  local target="$2"
  local label="$3"
  if path_is_symlink "$entry"; then
    verify_expected_link "$entry" "$target" "$label"
  elif [ -e "$entry" ]; then
    die "$label entry has an unexpected file type"
  else
    create_symlink "$target" "$entry"
    verify_expected_link "$entry" "$target" "$label"
  fi
  set_link_owner "$entry"
}

ensure_shared_links() {
  local release="$1"
  local env_target="$shared/.env.production"
  local db_target="$shared/prisma/dev.db"
  local prisma_directory="$release/prisma"
  validate_exact_directory "$shared" "shared root"
  validate_exact_directory "$shared/prisma" "shared Prisma directory"
  validate_canonical_shared_file "$env_target" "production environment file"
  validate_canonical_shared_file "$db_target" "production database"
  validate_exact_directory "$prisma_directory" "release Prisma directory"
  [ "$(dirname -- "$release/.env.production")" = "$release" ] || die "release environment entry escaped the release"
  [ "$(dirname -- "$release/prisma/dev.db")" = "$prisma_directory" ] || die "release database entry escaped the release"
  ensure_expected_link "$release/.env.production" "$env_target" "release environment"
  ensure_expected_link "$release/prisma/dev.db" "$db_target" "release database"
}

verify_shared_links() {
  local release="$1"
  local env_target="$shared/.env.production"
  local db_target="$shared/prisma/dev.db"
  local prisma_directory="$release/prisma"
  validate_exact_directory "$shared" "shared root"
  validate_exact_directory "$shared/prisma" "shared Prisma directory"
  validate_canonical_shared_file "$env_target" "production environment file"
  validate_canonical_shared_file "$db_target" "production database"
  validate_exact_directory "$prisma_directory" "release Prisma directory"
  verify_expected_link "$release/.env.production" "$env_target" "release environment"
  verify_expected_link "$release/prisma/dev.db" "$db_target" "release database"
}

verify_build_artifact() {
  local release="$1"
  local next_directory="$release/.next"
  local build_id="$next_directory/BUILD_ID"
  [ -d "$next_directory" ] || die "staged build directory is missing"
  ! path_is_symlink "$next_directory" || die "staged build directory must not be a symlink"
  [ "$(resolve_existing_path "$next_directory")" = "$next_directory" ] || die "staged build directory escapes the release"
  [ -f "$build_id" ] || die "staged BUILD_ID is missing"
  ! path_is_symlink "$build_id" || die "staged BUILD_ID must not be a symlink"
  [ -s "$build_id" ] || die "staged BUILD_ID is empty"
}

build_id_sha256() {
  sha256sum "$1/.next/BUILD_ID" | awk '{print $1}'
}

provenance_text() {
  local release="$1"
  local commit="$2"
  local ref="$3"
  local remote_head="$4"
  local build_sha
  build_sha="$(build_id_sha256 "$release")"
  cat <<EOF
format=1
commit=$commit
allowed_ref=$ref
remote_head=$remote_head
repository=$repository
build_id_sha256=$build_sha
deployer_version=$deployer_version
EOF
}

write_provenance() {
  local release="$1"
  local commit="$2"
  local ref="$3"
  local remote_head="$4"
  local provenance="$release/.git/$provenance_name"
  local temporary="$release/.git/.$provenance_name.$$.new"
  if [ -e "$provenance" ] || path_is_symlink "$provenance"; then
    [ -f "$provenance" ] && ! path_is_symlink "$provenance" || die "existing staged provenance is unsafe"
  fi
  [ ! -e "$temporary" ] && ! path_is_symlink "$temporary" || die "provenance temporary path collision"
  provenance_text "$release" "$commit" "$ref" "$remote_head" > "$temporary"
  chmod 0600 "$temporary"
  set_file_owner "$temporary"
  atomic_replace_path "$temporary" "$provenance"
}

verified_remote_head=""
verify_staged_release() {
  local release="$1"
  local commit="$2"
  local ref="$3"
  local provenance="$release/.git/$provenance_name"
  local recorded_remote_head
  local expected
  local actual
  validate_release_directory "$release" "$commit"
  validate_origin "$release"
  validate_git_state "$release" "$commit"
  verify_shared_links "$release"
  verify_build_artifact "$release"
  [ -f "$provenance" ] && ! path_is_symlink "$provenance" || die "staged provenance is missing or unsafe"
  [ "$(wc -l < "$provenance" | tr -d ' ')" = "7" ] || die "staged provenance has an unexpected shape"
  recorded_remote_head="$(sed -n 's/^remote_head=//p' "$provenance")"
  is_exact_commit "$recorded_remote_head" || die "staged provenance remote HEAD is invalid"
  git_in_release "$release" cat-file -e "${recorded_remote_head}^{commit}" || die "recorded remote HEAD object is missing"
  git_in_release "$release" merge-base --is-ancestor "$commit" "$recorded_remote_head" || die "staged commit is not reachable from its recorded remote HEAD"
  expected="$(provenance_text "$release" "$commit" "$ref" "$recorded_remote_head")"
  actual="$(cat "$provenance")"
  [ "$actual" = "$expected" ] || die "staged provenance does not match the release"
  verified_remote_head="$recorded_remote_head"
}

current_release=""
current_commit=""
validate_current_link() {
  local direct_target
  current_release=""
  current_commit=""
  if path_is_symlink "$current_link"; then
    direct_target="$(read_symlink_target "$current_link")"
    case "$direct_target" in
      "$release_root"/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;;
      *) die "current link is not a direct approved release target" ;;
    esac
    [ "$(resolve_existing_path "$current_link")" = "$direct_target" ] || die "current link resolves through an unexpected chain"
    current_release="$direct_target"
    current_commit="$(basename -- "$current_release")"
    validate_release_directory "$current_release" "$current_commit"
    [ "$(git_in_release "$current_release" rev-parse HEAD)" = "$current_commit" ] || die "current release HEAD differs from its path"
  elif [ -e "$current_link" ]; then
    die "current path exists but is not a symlink"
  fi
}

temporary_current_path() {
  local commit="$1"
  printf '%s/.current.%s.%s.new\n' "$(dirname -- "$current_link")" "$$" "$commit"
}

atomic_switch_current() {
  local release="$1"
  local commit
  local temporary
  commit="$(basename -- "$release")"
  validate_release_directory "$release" "$commit"
  validate_current_link
  temporary="$(temporary_current_path "$commit")"
  [ "$(dirname -- "$temporary")" = "$(dirname -- "$current_link")" ] || die "temporary current path has an unexpected parent"
  [ ! -e "$temporary" ] && ! path_is_symlink "$temporary" || die "temporary current path collision"
  create_symlink "$release" "$temporary"
  path_is_symlink "$temporary" || die "temporary current link was not created"
  [ "$(read_symlink_target "$temporary")" = "$release" ] || die "temporary current link target differs"
  [ "$(resolve_existing_path "$temporary")" = "$release" ] || die "temporary current link resolves unexpectedly"
  set_link_owner "$temporary"
  echo "Current link replacement prepared: previous=${current_release:-none} target=$release"
  atomic_replace_path "$temporary" "$current_link"
  echo "Current link replacement executed: previous=${current_release:-none} target=$release"
  path_is_symlink "$current_link" || die "current link switch did not publish a symlink"
  [ "$(read_symlink_target "$current_link")" = "$release" ] || die "current link target differs after switch"
  [ "$(resolve_existing_path "$current_link")" = "$release" ] || die "current link resolution differs after switch"
}

prepared_path=""
prepared_release=""
prepared_remote_head=""
prepared_reused=false
prepare_release() {
  local commit="$1"
  local ref="$2"
  local release
  local staging
  release="$(release_path_for "$commit")"
  prepared_release="$release"
  prepared_reused=false

  if [ -e "$release" ] || path_is_symlink "$release"; then
    validate_release_directory "$release" "$commit"
    verify_staged_release "$release" "$commit" "$ref"
    prepared_path="$release"
    prepared_remote_head="$verified_remote_head"
    prepared_reused=true
    return 0
  fi

  staging="$release_root/.staging-$commit-$$"
  [ ! -e "$staging" ] && ! path_is_symlink "$staging" || die "release preparation path collision"
  run_as_deploy_user git clone --no-checkout "$repository" "$staging"
  validate_preparation_directory "$staging"
  validate_origin "$staging"
  fetch_and_verify_reachability "$staging" "$commit" "$ref"
  git_in_release "$staging" checkout --detach "$commit"
  validate_git_state "$staging" "$commit"
  ensure_shared_links "$staging"
  validate_git_state "$staging" "$commit"
  prepared_path="$staging"
  prepared_remote_head="$fetched_remote_head"
}

refresh_prepared_remote_provenance() {
  local release="$1"
  local commit="$2"
  local ref="$3"
  fetch_and_verify_reachability "$release" "$commit" "$ref"
  prepared_remote_head="$fetched_remote_head"
}

publish_prepared_release() {
  local commit="$1"
  write_provenance "$prepared_path" "$commit" "$allowed_ref" "$prepared_remote_head"
  verify_build_artifact "$prepared_path"
  validate_git_state "$prepared_path" "$commit"
  if [ "$prepared_path" != "$prepared_release" ]; then
    [ ! -e "$prepared_release" ] && ! path_is_symlink "$prepared_release" || die "release destination appeared during preparation"
    atomic_replace_path "$prepared_path" "$prepared_release"
    prepared_path="$prepared_release"
  fi
  verify_staged_release "$prepared_release" "$commit" "$allowed_ref"
}

target_commit=""
resolve_target_commit() {
  if [ -n "$requested_commit" ]; then
    target_commit="$requested_commit"
  else
    target_commit="$(remote_ref_head "$allowed_ref")"
  fi
  is_exact_commit "$target_commit" || die "unable to resolve a valid deployment commit"
}

print_stage_dry_run() {
  local remote_head
  remote_head="$(remote_ref_head "$allowed_ref")"
  echo "Mode: stage-only (dry-run)"
  echo "Requested: $target_commit"
  echo "Allowed ref: $allowed_ref"
  echo "Allowed ref HEAD: $remote_head"
  echo "WOULD fetch the allowed ref, verify reachability, checkout, run checks, and build."
  echo "WOULD NOT back up or migrate the database."
  echo "WOULD NOT modify the production environment or content source."
  echo "WOULD NOT switch current."
  echo "WOULD NOT stop, start, restart, or reload the service."
}

print_activate_dry_run() {
  local release="$1"
  echo "Mode: activate-staged (dry-run)"
  echo "Requested: $target_commit"
  echo "Allowed ref: $allowed_ref"
  echo "WOULD verify staged release (read-only verification completed): $release"
  echo "WOULD switch current atomically to the verified staged release."
  echo "WOULD NOT install or build application dependencies."
  echo "WOULD NOT back up or migrate the database."
  echo "WOULD NOT modify the production environment or content source."
  echo "WOULD NOT stop, start, restart, or reload the service."
}

stage_only() {
  if [ "$dry_run" = true ]; then
    print_stage_dry_run
    return 0
  fi
  prepare_release "$target_commit" "$allowed_ref"
  if [ "$prepared_reused" = true ]; then
    echo "Already staged and verified: $target_commit"
    echo "Allowed ref: $allowed_ref"
    return 0
  fi
  run_release_static_checks "$prepared_path"
  run_release_build "$prepared_path"
  verify_build_artifact "$prepared_path"
  validate_git_state "$prepared_path" "$target_commit"
  publish_prepared_release "$target_commit"
  echo "Staged and verified: $target_commit"
  echo "Release: $prepared_release"
  echo "Allowed ref: $allowed_ref"
  echo "Current and service were not changed."
}

activate_staged() {
  local release
  local previous
  release="$(release_path_for "$target_commit")"
  verify_staged_release "$release" "$target_commit" "$allowed_ref"
  validate_current_link
  previous="$current_release"
  if [ "$current_release" = "$release" ]; then
    echo "Already activated: $target_commit"
    return 0
  fi
  if [ "$dry_run" = true ]; then
    print_activate_dry_run "$release"
    return 0
  fi
  run_student_id_preflight
  atomic_switch_current "$release"
  echo "Activated staged release: $target_commit"
  echo "Previous: ${previous:-none}"
  echo "Service was not started or restarted."
}

full_deploy() {
  local previous
  validate_current_link
  previous="$current_release"
  if [ "$target_commit" = "$current_commit" ]; then
    echo "Already deployed: $target_commit"
    return 0
  fi
  if [ "$dry_run" = true ]; then
    echo "Mode: full deploy (dry-run)"
    echo "Would deploy: $target_commit"
    echo "Allowed ref: $allowed_ref"
    echo "Current: ${current_commit:-none}"
    echo "WOULD run legacy checks, DB backup, migration, build, current switch, restart, and health verification."
    return 0
  fi

  prepare_release "$target_commit" "$allowed_ref"
  if [ "$prepared_reused" = true ]; then
    refresh_prepared_remote_provenance "$prepared_path" "$target_commit" "$allowed_ref"
  fi
  run_student_id_preflight
  run_release_static_checks "$prepared_path"
  run_db_backup
  run_migration "$prepared_path"
  run_release_build "$prepared_path"
  verify_build_artifact "$prepared_path"
  validate_git_state "$prepared_path" "$target_commit"
  publish_prepared_release "$target_commit"
  run_student_id_preflight
  atomic_switch_current "$prepared_release"

  if ! restart_service; then
    if [ -n "$previous" ]; then
      atomic_switch_current "$previous" || true
      restart_service || true
    fi
    echo "Service restart failed; restored the previous release link." >&2
    return 1
  fi

  if ! wait_for_health; then
    if [ -n "$previous" ]; then
      atomic_switch_current "$previous" || true
      restart_service || true
    fi
    echo "Health check failed; restored the previous release link. Database migrations were not rolled back." >&2
    return 1
  fi

  echo "Deployed: $target_commit"
  echo "Previous: ${current_commit:-none}"
}

main() {
  parse_args "$@" || return $?
  if [ "$show_help" = true ]; then
    usage
    return 0
  fi
  if [ "$show_version" = true ]; then
    echo "nuaafa-deploy $deployer_version"
    return 0
  fi

  require_root
  prepare_process
  validate_fixed_configuration
  validate_allowed_ref "$allowed_ref"
  validate_layout_roots
  acquire_lock
  resolve_target_commit

  case "$operation_mode" in
    stage)
      stage_only
      ;;
    activate)
      activate_staged
      ;;
    full)
      full_deploy
      ;;
    *)
      die "unknown deployment mode"
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
