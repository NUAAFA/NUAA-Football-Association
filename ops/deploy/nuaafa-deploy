#!/usr/bin/env bash
set -Eeuo pipefail

deployer_version="V2.10X-PREBUILT-3"
prebuilt_timing=false
# Preserve the canonical HTTPS origin already approved and installed for V2.10.
repository="https://github.com/NUAAFA/NUAA-Football-Association.git"
release_root="/srv/nuaafa/releases"
shared="/srv/nuaafa/shared"
current_link="/srv/nuaafa/current"
deploy_user="nuaafa"
service_name="nuaafa.service"
db_backup_command="/usr/local/sbin/nuaafa-db-backup"
student_id_preflight_command="/usr/local/lib/nuaafa/student-id-release-preflight.mjs"
student_id_preflight_node="/usr/bin/node"
lock_file="/run/nuaafa-deploy.lock"
default_allowed_ref="refs/heads/main"
provenance_name="nuaafa-staged-release.v1"
prebuilt_helper="/usr/local/lib/nuaafa/prebuilt-artifact.py"
prebuilt_python="/usr/bin/python3"
# Outside candidate releases: root-owned receipts and independent approvals.
prebuilt_state="/srv/nuaafa/prebuilt"
prebuilt_approvals="/etc/nuaafa/prebuilt-approvals"
activation_state="/srv/nuaafa/prebuilt-activation.json"
prebuilt_start="/usr/local/lib/nuaafa/start-prebuilt"
artifact_path=""
artifact_sha256=""

operation_mode="full"
mode_selected=false
dry_run=false
requested_commit=""
allowed_ref="$default_allowed_ref"
show_help=false
show_version=false

die() {
  echo "STOP: $*" >&2
  return 1
}

usage_error() {
  echo "Usage: nuaafa-deploy [--dry-run] [--allowed-ref REF] [--stage-only|--activate-staged|--import-artifact ARCHIVE|--activate-prebuilt] [--artifact-sha256 SHA256] [40-character-commit]" >&2
  return 2
}

usage() {
  cat <<'EOF'
Usage: nuaafa-deploy [--dry-run] [--allowed-ref refs/heads/BRANCH] [--stage-only|--activate-staged] [40-character-commit]
       nuaafa-deploy --import-artifact ARCHIVE --artifact-sha256 SHA256 [--allowed-ref REF] COMMIT
       nuaafa-deploy --activate-prebuilt --artifact-sha256 SHA256 [--allowed-ref REF] COMMIT

Modes:
  default             Legacy full deploy: prepare, backup, migrate, build,
                      switch current, restart, and verify health.
  --stage-only        Prepare and build an exact release without DB, current,
                      service, content, upload, environment, or timer mutation.
  --activate-staged   Verify and atomically switch to a staged release only.
  --import-artifact   Verify and import a prebuilt candidate; no shared data,
                      build, candidate execution, current switch or restart.
  --activate-prebuilt Require independent security/Linux/Human Review approval;
                      preflight, backup, migrate, switch, restart and health.

Prebuilt modes require an exact commit and an independently obtained SHA-256.
Import success is not release approval. Never trust an archive's own checksum
file as the sole authority. Legacy modes cannot activate imported candidates.

Stage-only and activate-staged require an explicit 40-character commit.
The allowed ref defaults to refs/heads/main; R1-3D feature staging must pass its
reviewed refs/heads/... value explicitly.
EOF
}

select_mode() {
  local requested_mode="$1"
  if [ "$mode_selected" = true ]; then
    die "conflicting deployment modes"
    return 2
  fi
  operation_mode="$requested_mode"
  mode_selected=true
}

parse_args() {
  operation_mode="full"
  mode_selected=false
  dry_run=false
  requested_commit=""
  allowed_ref="$default_allowed_ref"
  show_help=false
  show_version=false
  artifact_path=""
  artifact_sha256=""

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --dry-run)
        dry_run=true
        ;;
      --stage-only)
        select_mode "stage" || return $?
        ;;
      --activate-staged)
        select_mode "activate" || return $?
        ;;
      --import-artifact)
        select_mode "import" || return $?
        shift
        [ "$#" -gt 0 ] || { usage_error; return 2; }
        artifact_path="$1"
        ;;
      --activate-prebuilt)
        select_mode "prebuilt" || return $?
        ;;
      --artifact-sha256)
        shift
        [ "$#" -gt 0 ] || { usage_error; return 2; }
        [ -z "$artifact_sha256" ] || { die "duplicate artifact checksum"; return 2; }
        artifact_sha256="$1"
        ;;
      --allowed-ref)
        shift
        if [ "$#" -eq 0 ]; then
          usage_error
          return $?
        fi
        allowed_ref="$1"
        ;;
      --version)
        show_version=true
        ;;
      -h|--help)
        show_help=true
        ;;
      -*)
        echo "Unknown option: $1" >&2
        usage_error
        return $?
        ;;
      *)
        if [ -n "$requested_commit" ]; then
          echo "Only one commit may be specified." >&2
          usage_error
          return $?
        fi
        requested_commit="$1"
        ;;
    esac
    shift
  done

  if [ "$operation_mode" != "full" ] && [ -z "$requested_commit" ]; then
    echo "An exact commit is required for $operation_mode mode." >&2
    usage_error
    return $?
  fi
  if [ "$operation_mode" = "import" ] || [ "$operation_mode" = "prebuilt" ]; then
    [[ "$artifact_sha256" =~ ^[0-9a-f]{64}$ ]] || { die "prebuilt mode requires an independent exact SHA-256"; return 2; }
  else
    [ -z "$artifact_sha256" ] || { die "artifact checksum is only valid in prebuilt modes"; return 2; }
  fi
}

require_root() {
  if [ "${EUID:-$(id -u)}" -ne 0 ]; then
    die "run this command as root"
  fi
}

prepare_process() {
  umask 077
  cd /
}

acquire_lock() {
  verify_root_metadata "$(dirname -- "$lock_file")" || return $?
  if [ -e "$lock_file" ] || path_is_symlink "$lock_file"; then
    verify_root_metadata "$lock_file" || return $?
    [ -f "$lock_file" ] || return 1
  else
    (set -o noclobber; : > "$lock_file") || return $?
  fi
  exec 9<>"$lock_file" || return $?
  flock -n 9 || { die "another NUAAFA deployment is already running"; return 1; }
}

run_as_deploy_user() {
  runuser -u "$deploy_user" -- "$@"
}

set_link_owner() {
  if [ "$operation_mode" = prebuilt ] || [ "$operation_mode" = import ]; then chown -h root:root "$@"; else chown -h "$deploy_user:$deploy_user" "$@"; fi
}

set_file_owner() {
  chown "$deploy_user:$deploy_user" "$@"
}

set_release_tree_owner() {
  chown -R "$deploy_user:$deploy_user" "$1"
}

verify_release_owner() {
  local owner
  owner="$(stat -c '%U' "$1")" || return $?
  if [ "$operation_mode" = prebuilt ] || [ "$operation_mode" = import ]; then
    [ "$owner" = root ] || { [ "$1" = "${activation_previous:-}" ] && [ "$owner" = "$deploy_user" ]; } || { die "prebuilt release must be root-owned"; return 1; }
  else
    [ "$owner" = "$deploy_user" ] || { die "release path is not owned by $deploy_user: $1"; return 1; }
  fi
}

run_release_static_checks() {
  local release="$1"
  run_as_deploy_user bash -lc "set -e; cd '$release'; npm ci; npm run lint; npm run check:unicode; npm run test:referee-flow; npm audit; npx prisma generate; npx prisma validate"
}

run_release_build() {
  local release="$1"
  run_as_deploy_user bash -lc "set -e; cd '$release'; npm run build; test -f .next/BUILD_ID"
}

run_db_backup() {
  verify_root_metadata "$db_backup_command" || return $?
  [ -f "$db_backup_command" ] && [ -x "$db_backup_command" ] || { die "trusted backup command missing"; return 1; }
  "$db_backup_command"
}

run_student_id_preflight() {
  local report
  validate_canonical_shared_file "$shared/prisma/dev.db" "production database" || return $?
  verify_root_metadata "$student_id_preflight_command" || return $?
  [ -f "$student_id_preflight_command" ] && ! path_is_symlink "$student_id_preflight_command" || { die "installed student ID preflight is missing or unsafe"; return 1; }
  report="$(run_as_deploy_user env -i "$student_id_preflight_node" "$student_id_preflight_command" "--database=$shared/prisma/dev.db")" || { die "student ID release preflight blocked release"; return 1; }
  if ! run_as_deploy_user env -i "$student_id_preflight_node" --input-type=module - "$report" <<'NODE'
const keys = ['totalReferees', 'totalActiveAccounts', 'missingStudentId', 'activeMissingStudentId', 'activeNonNormalizedStudentId', 'duplicateStudentIdGroups', 'unsafeLoginMigrationBlockers', 'scanComplete', 'readOnlyVerified', 'releaseAllowed'];
try {
  const r = JSON.parse(process.argv[2]);
  if (!r || Object.keys(r).length !== keys.length || !keys.every(k => Number.isSafeInteger(r[k]) && r[k] >= 0) ||
      r.scanComplete !== 1 || r.readOnlyVerified !== 1 || r.releaseAllowed !== 1 || r.unsafeLoginMigrationBlockers !== 0 ||
      r.unsafeLoginMigrationBlockers !== r.activeMissingStudentId + r.activeNonNormalizedStudentId + r.duplicateStudentIdGroups ||
      r.totalActiveAccounts > r.totalReferees || r.missingStudentId > r.totalReferees ||
      r.activeMissingStudentId > r.missingStudentId || r.activeMissingStudentId > r.totalActiveAccounts ||
      r.activeNonNormalizedStudentId > r.totalActiveAccounts) process.exit(1);
} catch { process.exit(1); }
NODE
  then
    die "student ID release preflight output is unverifiable"
    return 1
  fi
  printf '%s\n' "$report"
}

run_migration() (
  local release="$1" log status
  cd "$release" || return $?
  umask 077
  # Outside release/work directories; create-only logs survive trap cleanup.
  verify_root_metadata "$(dirname -- "$activation_state")" || return $?
  log="$(mktemp "${activation_state}.migration.${target_commit}.log.XXXXXXXX")" || return $?
  echo "Preserved migration log: $log" >&2
  if run_as_deploy_user env -i PATH=/usr/bin:/bin NODE_ENV=production DOTENV_CONFIG_PATH="$release/.env.production" DATABASE_URL="file:$shared/prisma/dev.db" "$student_id_preflight_node" "$release/node_modules/prisma/build/index.js" migrate deploy --config "$release/prisma.config.ts" 2>&1 | tee "$log"; then
    status=0
  else
    status=$?
  fi
  "$prebuilt_python" -I -c 'import os,sys; f=os.open(sys.argv[1],os.O_RDONLY|os.O_NOFOLLOW); os.fsync(f); os.close(f); d=os.open(os.path.dirname(sys.argv[1]),os.O_DIRECTORY); os.fsync(d); os.close(d)' "$log" || return $?
  return "$status"
)

restart_service() {
  systemctl restart "$service_name"
}

wait_for_health() {
  local attempt pid
  for attempt in $(seq 1 20); do
    if systemctl is-active --quiet "$service_name" &&
       curl --fail --silent --show-error --max-time 5 http://127.0.0.1:3001/api/health |
         "$prebuilt_python" -I -c 'import json,sys;sys.exit(0 if json.load(sys.stdin)=={"status":"ok"} else 1)'; then
      pid="$(systemctl show --value -p MainPID "$service_name")" || return $?
      [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
      [ "$(resolve_existing_path "/proc/$pid/cwd")" = "$(resolve_existing_path "$current_link")" ] || return 1
      return 0
    fi
    sleep 1
  done
  return 1
}

stop_service() { systemctl stop "$service_name"; }

verify_service_contract() {
  verify_root_metadata "$prebuilt_start" || return $?
  [ -x "$prebuilt_start" ] || { die "trusted prebuilt start command missing"; return 1; }
  [ "$(run_as_deploy_user "$prebuilt_python" -I "$prebuilt_start" --contract-version)" = "NUAAFA_STARTUP_CONTRACT=V2.10X-PREBUILT-3" ] || { die "reviewed V2.10.x startup contract must be installed before migration"; return 1; }
  [ "$(systemctl show --value -p User "$service_name")" = "$deploy_user" ] || { die "service identity differs"; return 1; }
  [ "$(systemctl show --value -p WorkingDirectory "$service_name")" = "$current_link" ] || { die "service working directory differs"; return 1; }
  local property configuration
  configuration="$(systemctl show --value -p FragmentPath "$service_name")" || return $?
  verify_root_metadata "$configuration" || return $?
  local dropins
  dropins="$(systemctl show --value -p DropInPaths "$service_name")" || return $?
  for configuration in $dropins; do verify_root_metadata "$configuration" || return $?; done
  for property in Environment EnvironmentFiles PassEnvironment RootDirectory RootImage BindPaths BindReadOnlyPaths; do
    [ -z "$(systemctl show --value -p "$property" "$service_name")" ] || { die "service has an additional environment or filesystem source"; return 1; }
  done
  for property in ExecStartPre ExecStartPost ExecCondition ExecStop ExecStopPost; do
    [ -z "$(systemctl show --value -p "$property" "$service_name")" ] || { die "service has additional unreviewed commands"; return 1; }
  done
  local command
  command="$(systemctl show --value -p ExecStart "$service_name")" || return $?
  # systemd exposes path and argv; reject alternate startup flags/scripts.
  [[ "$command" = "{ path=$prebuilt_start ; argv[]=$prebuilt_start ; "* ]] &&
    [[ "$command" != *"} {"* ]] || { die "service must use the reviewed prebuilt start contract"; return 1; }
}

run_prebuilt_backup() (
  local release="$1" output backup verified
  cd "$release" || return $?
  validate_exact_directory "$shared/uploads" "shared uploads" || return $?
  validate_exact_directory "$shared/backups/unified" "unified backup root" || return $?
  output="$(run_as_deploy_user env -i PATH=/usr/bin:/bin NODE_ENV=production DATABASE_URL="file:$shared/prisma/dev.db" NUAAFA_UPLOAD_DIR="$shared/uploads" "$student_id_preflight_node" "$release/node_modules/tsx/dist/cli.mjs" "$release/scripts/backup-unified-data.ts" "--root=$shared/backups/unified")" || { die "combined pre-migration backup failed"; return 1; }
  backup="$(printf '%s' "$output" | "$prebuilt_python" -I -c 'import json,sys;print(json.load(sys.stdin)["outputDirectory"])')" || return $?
  [[ "$backup" = "$shared/backups/unified/"* ]] && [ "$(dirname -- "$backup")" = "$shared/backups/unified" ] || { die "backup destination outside approved root"; return 1; }
  validate_exact_directory "$backup" "created backup" || return $?
  verified="$(run_as_deploy_user env -i PATH=/usr/bin:/bin NODE_ENV=production "$student_id_preflight_node" "$release/node_modules/tsx/dist/cli.mjs" "$release/scripts/verify-unified-backup.ts" "--backup=$backup")" || { die "fresh backup failed independent verification"; return 1; }
  printf '%s' "$verified" | "$prebuilt_python" -I -c 'import json,sys;sys.exit(0 if json.load(sys.stdin).get("valid") is True else 1)' || return $?
  echo "Fresh combined backup created and independently verified: $backup"
)

activation_database_digest=""
activation_phase=""
activation_work=""
activation_previous=""
activation_release=""
record_activation_phase() {
  local proof_args=()
  if [ -n "$activation_database_digest" ]; then proof_args=(--database-sha256 "$activation_database_digest"); fi
  run_prebuilt_helper state --path "$activation_state" --commit "$target_commit" --previous "$(basename -- "$activation_previous")" --phase "$1" "${proof_args[@]}" || return $?
  activation_phase="$1"
}

recover_activation() {
  # Any uncertain migration state must stay stopped for explicit operator recovery.
  case "$activation_phase" in
    PREPARED|SERVICE_STOPPING|SERVICE_STOPPED)
      if run_prebuilt_helper recovery-ready --path "$activation_state" --previous "$activation_previous" --database "$shared/prisma/dev.db" --commit "$target_commit" --phase "$activation_phase" &&
         validate_recovery_release "$activation_previous" && verify_recovery_startup "$activation_previous" &&
         run_student_id_preflight && atomic_switch_current "$activation_previous" && restart_service && wait_for_health; then
        if record_activation_phase ROLLED_BACK; then
          echo "Previous release link AND service health verified; durable pre-migration proof and unchanged database verified." >&2
          return 0
        fi
        # Healthy old runtime without a durable recovery journal is not a
        # completed rollback. Fall through to stopped/manual recovery below.
      fi
      ;;
    HEALTHY|ROLLED_BACK) return 0 ;;
  esac
  # Best-effort stop is never recorded as successful recovery.
  if ! stop_service; then echo "STOP: service stop also failed; inspect service immediately" >&2; fi
  record_activation_phase MANUAL_REQUIRED || echo "STOP: fault-state persistence failed" >&2
  echo "STOP: manual recovery required. Keep service stopped; inspect $activation_state, current, migration history and verified backup. Do not reverse migrations or restore a database automatically." >&2
  return 1
}

activation_exit() {
  local status="$1"
  trap - EXIT INT TERM
  if [ "$status" -ne 0 ] && [ -n "$activation_phase" ]; then
    if ! recover_activation; then status=1; fi
  fi
  exit "$status"
}

# Keep filesystem link operations behind small primitives. Production uses the
# native tools below; the isolated Windows test harness replaces only these
# primitives because Git for Windows emulates links without a readable target.
path_is_symlink() {
  [ -L "$1" ]
}

read_symlink_target() {
  readlink -- "$1"
}

resolve_existing_path() {
  readlink -f -- "$1"
}

create_symlink() {
  ln -s -- "$1" "$2"
}

atomic_replace_path() {
  mv -T -- "$1" "$2"
}

is_exact_commit() {
  [[ "$1" =~ ^[0-9a-f]{40}$ ]]
}

validate_allowed_ref() {
  local ref="$1"
  [[ "$ref" =~ ^refs/heads/[A-Za-z0-9][A-Za-z0-9._/-]*$ ]] || { die "allowed ref must be an explicit refs/heads/... value"; return 1; }
  [[ "$ref" != *".."* && "$ref" != *"//"* && "$ref" != */ && "$ref" != *"@{"* && "$ref" != *\\* ]] || { die "allowed ref contains an unsafe sequence"; return 1; }
}

validate_fixed_configuration() {
  case "$repository" in
    *$'\n'*|*$'\r'*) die "repository contains a newline"; return 1 ;;
  esac
  [[ "$release_root" = /* && "$shared" = /* && "$current_link" = /* ]] || { die "deployment paths must be absolute"; return 1; }
  [ "$(dirname -- "$current_link")" = "$(dirname -- "$release_root")" ] || { die "current and releases must share the approved parent"; return 1; }
}

validate_exact_directory() {
  local directory="$1"
  local label="$2"
  [ -d "$directory" ] || { die "$label is not a directory: $directory"; return 1; }
  ! path_is_symlink "$directory" || { die "$label must not be a symlink: $directory"; return 1; }
  [ "$(resolve_existing_path "$directory")" = "$directory" ] || { die "$label path is not canonical: $directory"; return 1; }
}

validate_layout_roots() {
  validate_exact_directory "$release_root" "release root" || return $?
  validate_exact_directory "$(dirname -- "$current_link")" "current parent" || return $?
  verify_root_metadata "$release_root" || return $?
}

release_path_for() {
  printf '%s/%s\n' "$release_root" "$1"
}

validate_release_directory() {
  local release="$1"
  local commit="$2"
  is_exact_commit "$commit" || { die "release commit is not exact"; return 1; }
  [ "$release" = "$(release_path_for "$commit")" ] || { die "release path does not match the requested commit"; return 1; }
  [ "$(dirname -- "$release")" = "$release_root" ] || { die "release is not a direct child of the release root"; return 1; }
  [ "$(basename -- "$release")" = "$commit" ] || { die "release directory name does not match the commit"; return 1; }
  [ -d "$release" ] || { die "release directory is missing: $release"; return 1; }
  ! path_is_symlink "$release" || { die "release directory must not be a symlink: $release"; return 1; }
  [ "$(resolve_existing_path "$release")" = "$release" ] || { die "release directory escapes the release root"; return 1; }
  verify_release_owner "$release" || return $?
  [ -d "$release/.git" ] || { die "release Git directory is missing"; return 1; }
  ! path_is_symlink "$release/.git" || { die "release Git directory must not be a symlink"; return 1; }
}

validate_preparation_directory() {
  local directory="$1"
  [ "$(dirname -- "$directory")" = "$release_root" ] || { die "preparation directory is outside the release root"; return 1; }
  [ -d "$directory" ] || { die "preparation directory is missing"; return 1; }
  ! path_is_symlink "$directory" || { die "preparation directory must not be a symlink"; return 1; }
  [ "$(resolve_existing_path "$directory")" = "$directory" ] || { die "preparation directory escapes the release root"; return 1; }
  verify_release_owner "$directory" || return $?
  [ -d "$directory/.git" ] && ! path_is_symlink "$directory/.git" || { die "preparation Git directory is unsafe"; return 1; }
}

git_in_release() {
  local release="$1"
  shift
  run_as_deploy_user env GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null GIT_OPTIONAL_LOCKS=0 GIT_NO_REPLACE_OBJECTS=1 git --no-replace-objects -c "safe.directory=$release" -c core.hooksPath=/dev/null -c core.fsmonitor=false -C "$release" "$@" || return $?
}

validate_origin() {
  local release="$1"
  local origin
  origin="$(git_in_release "$release" remote get-url origin)" || return $?
  [ "$origin" = "$repository" ] || { die "release origin differs from the approved repository"; return 1; }
}

validate_git_state() {
  local release="$1"
  local commit="$2"
  local head
  local status
  head="$(git_in_release "$release" rev-parse HEAD)" || return $?
  [ "$head" = "$commit" ] || { die "release HEAD differs from the requested commit"; return 1; }
  status="$(git_in_release "$release" status --porcelain)" || return $?
  [ -z "$status" ] || { die "release Git worktree is not clean"; return 1; }
}

remote_ref_head() {
  local ref="$1"
  local output
  local line_count
  local head
  output="$(run_as_deploy_user git ls-remote --heads "$repository" "$ref")" || return $?
  line_count="$(printf '%s\n' "$output" | sed '/^$/d' | wc -l | tr -d ' ')"
  [ "$line_count" = "1" ] || { die "allowed remote ref did not resolve exactly once: $ref"; return 1; }
  head="$(printf '%s\n' "$output" | awk 'NF >= 2 {print $1}')"
  is_exact_commit "$head" || { die "allowed remote ref did not resolve to an exact commit"; return 1; }
  printf '%s\n' "$head"
}

fetched_remote_head=""
fetch_and_verify_reachability() {
  local release="$1"
  local commit="$2"
  local ref="$3"
  git_in_release "$release" fetch --no-tags origin "$ref" || return $?
  fetched_remote_head="$(git_in_release "$release" rev-parse FETCH_HEAD)" || return $?
  is_exact_commit "$fetched_remote_head" || { die "fetched allowed ref is not an exact commit"; return 1; }
  git_in_release "$release" cat-file -e "${commit}^{commit}" || { die "requested commit was not obtained from the approved repository"; return 1; }
  git_in_release "$release" merge-base --is-ancestor "$commit" "$fetched_remote_head" || { die "requested commit is not reachable from the allowed remote ref"; return 1; }
}

validate_canonical_shared_file() {
  local file="$1"
  local label="$2"
  [ -f "$file" ] || { die "$label is not a regular file: $file"; return 1; }
  ! path_is_symlink "$file" || { die "$label must not be a symlink: $file"; return 1; }
  [ "$(resolve_existing_path "$file")" = "$file" ] || { die "$label path is not canonical: $file"; return 1; }
}

verify_expected_link() {
  local entry="$1"
  local target="$2"
  local label="$3"
  path_is_symlink "$entry" || { die "$label entry is not a symlink"; return 1; }
  [ "$(read_symlink_target "$entry")" = "$target" ] || { die "$label link does not directly target the canonical path"; return 1; }
  [ "$(resolve_existing_path "$entry")" = "$target" ] || { die "$label link resolves outside the canonical target"; return 1; }
}

ensure_expected_link() {
  local entry="$1"
  local target="$2"
  local label="$3"
  if path_is_symlink "$entry"; then
    verify_expected_link "$entry" "$target" "$label" || return $?
  elif [ -e "$entry" ]; then
    die "$label entry has an unexpected file type"; return 1
  else
    create_symlink "$target" "$entry" || return $?
    verify_expected_link "$entry" "$target" "$label" || return $?
  fi
  set_link_owner "$entry" || return $?
}

ensure_shared_links() {
  local release="$1"
  local env_target="$shared/.env.production"
  local db_target="$shared/prisma/dev.db"
  local prisma_directory="$release/prisma"
  validate_exact_directory "$shared" "shared root" || return $?
  validate_exact_directory "$shared/prisma" "shared Prisma directory" || return $?
  validate_canonical_shared_file "$env_target" "production environment file" || return $?
  validate_canonical_shared_file "$db_target" "production database" || return $?
  validate_exact_directory "$prisma_directory" "release Prisma directory" || return $?
  [ "$(dirname -- "$release/.env.production")" = "$release" ] || { die "release environment entry escaped the release"; return 1; }
  [ "$(dirname -- "$release/prisma/dev.db")" = "$prisma_directory" ] || { die "release database entry escaped the release"; return 1; }
  ensure_expected_link "$release/.env.production" "$env_target" "release environment" || return $?
  ensure_expected_link "$release/prisma/dev.db" "$db_target" "release database" || return $?
}

verify_shared_links() {
  local release="$1"
  local env_target="$shared/.env.production"
  local db_target="$shared/prisma/dev.db"
  local prisma_directory="$release/prisma"
  validate_exact_directory "$shared" "shared root" || return $?
  validate_exact_directory "$shared/prisma" "shared Prisma directory" || return $?
  validate_canonical_shared_file "$env_target" "production environment file" || return $?
  validate_canonical_shared_file "$db_target" "production database" || return $?
  validate_exact_directory "$prisma_directory" "release Prisma directory" || return $?
  verify_expected_link "$release/.env.production" "$env_target" "release environment" || return $?
  verify_expected_link "$release/prisma/dev.db" "$db_target" "release database" || return $?
}

verify_build_artifact() {
  local release="$1"
  local next_directory="$release/.next"
  local build_id="$next_directory/BUILD_ID"
  [ -d "$next_directory" ] || { die "staged build directory is missing"; return 1; }
  ! path_is_symlink "$next_directory" || { die "staged build directory must not be a symlink"; return 1; }
  [ "$(resolve_existing_path "$next_directory")" = "$next_directory" ] || { die "staged build directory escapes the release"; return 1; }
  [ -f "$build_id" ] || { die "staged BUILD_ID is missing"; return 1; }
  ! path_is_symlink "$build_id" || { die "staged BUILD_ID must not be a symlink"; return 1; }
  [ -s "$build_id" ] || { die "staged BUILD_ID is empty"; return 1; }
}

build_id_sha256() {
  sha256sum "$1/.next/BUILD_ID" | awk '{print $1}'
}

provenance_text() {
  local release="$1"
  local commit="$2"
  local ref="$3"
  local remote_head="$4"
  local build_sha
  build_sha="$(build_id_sha256 "$release")" || return $?
  cat <<EOF
format=1
commit=$commit
allowed_ref=$ref
remote_head=$remote_head
repository=$repository
build_id_sha256=$build_sha
deployer_version=$deployer_version
EOF
}

write_provenance() {
  local release="$1"
  local commit="$2"
  local ref="$3"
  local remote_head="$4"
  local provenance="$release/.git/$provenance_name"
  local temporary="$release/.git/.$provenance_name.$$.new"
  if [ -e "$provenance" ] || path_is_symlink "$provenance"; then
    [ -f "$provenance" ] && ! path_is_symlink "$provenance" || { die "existing staged provenance is unsafe"; return 1; }
  fi
  [ ! -e "$temporary" ] && ! path_is_symlink "$temporary" || { die "provenance temporary path collision"; return 1; }
  provenance_text "$release" "$commit" "$ref" "$remote_head" > "$temporary" || return $?
  chmod 0600 "$temporary"
  set_file_owner "$temporary" || return $?
  atomic_replace_path "$temporary" "$provenance" || return $?
}

verified_remote_head=""
verify_staged_release() {
  local release="$1"
  local commit="$2"
  local ref="$3"
  local provenance="$release/.git/$provenance_name"
  local recorded_remote_head
  local expected
  local actual
  validate_release_directory "$release" "$commit" || return $?
  validate_origin "$release" || return $?
  validate_git_state "$release" "$commit" || return $?
  verify_shared_links "$release" || return $?
  verify_build_artifact "$release" || return $?
  [ -f "$provenance" ] && ! path_is_symlink "$provenance" || { die "staged provenance is missing or unsafe"; return 1; }
  [ "$(wc -l < "$provenance" | tr -d ' ')" = "7" ] || { die "staged provenance has an unexpected shape"; return 1; }
  recorded_remote_head="$(sed -n 's/^remote_head=//p' "$provenance")"
  is_exact_commit "$recorded_remote_head" || { die "staged provenance remote HEAD is invalid"; return 1; }
  git_in_release "$release" cat-file -e "${recorded_remote_head}^{commit}" || { die "recorded remote HEAD object is missing"; return 1; }
  git_in_release "$release" merge-base --is-ancestor "$commit" "$recorded_remote_head" || { die "staged commit is not reachable from its recorded remote HEAD"; return 1; }
  expected="$(provenance_text "$release" "$commit" "$ref" "$recorded_remote_head")" || return $?
  actual="$(cat "$provenance")"
  [ "$actual" = "$expected" ] || { die "staged provenance does not match the release"; return 1; }
  verified_remote_head="$recorded_remote_head"
}

current_release=""
current_commit=""
validate_current_link() {
  local direct_target
  current_release=""
  current_commit=""
  if path_is_symlink "$current_link"; then
    direct_target="$(read_symlink_target "$current_link")" || return $?
    case "$direct_target" in
      "$release_root"/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;;
      *) die "current link is not a direct approved release target"; return 1 ;;
    esac
    [ "$(resolve_existing_path "$current_link")" = "$direct_target" ] || { die "current link resolves through an unexpected chain"; return 1; }
    current_release="$direct_target"
    current_commit="$(basename -- "$current_release")"
    local current_mode="$operation_mode"
    if [ "$(stat -c '%U' "$current_release")" = "$deploy_user" ]; then
      operation_mode=full
    elif [ -e "$(prebuilt_receipt "$current_commit")" ] || [ -e "$current_release/.git/nuaafa-prebuilt" ]; then
      operation_mode=prebuilt
    fi
    validate_release_directory "$current_release" "$current_commit" || { operation_mode="$current_mode"; return 1; }
    operation_mode="$current_mode"
    [ "$(git_in_release "$current_release" rev-parse HEAD)" = "$current_commit" ] || { die "current release HEAD differs from its path"; return 1; }
  elif [ -e "$current_link" ]; then
    die "current path exists but is not a symlink"; return 1
  fi
}

temporary_current_path() {
  local commit="$1"
  printf '%s/.current.%s.%s.new\n' "$(dirname -- "$current_link")" "$$" "$commit"
}

atomic_switch_current() (
  switch_temporary=""
  switch_temporary_owned=false
  trap 'status=$?; if [ "$switch_temporary_owned" = true ] && path_is_symlink "$switch_temporary" && [ "$(read_symlink_target "$switch_temporary")" = "$1" ]; then rm -- "$switch_temporary" || status=1; fi; exit "$status"' EXIT
  local release="$1"
  local commit
  local temporary
  commit="$(basename -- "$release")"
  if [ -e "$(prebuilt_receipt "$commit")" ] || [ -e "$release/.git/nuaafa-prebuilt" ]; then operation_mode=prebuilt; fi
  validate_release_directory "$release" "$commit" || return $?
  validate_current_link || return $?
  temporary="$(temporary_current_path "$commit")"
  [ "$(dirname -- "$temporary")" = "$(dirname -- "$current_link")" ] || { die "temporary current path has an unexpected parent"; return 1; }
  [ ! -e "$temporary" ] && ! path_is_symlink "$temporary" || { die "temporary current path collision"; return 1; }
  create_symlink "$release" "$temporary" || return $?
  switch_temporary="$temporary"
  switch_temporary_owned=true
  path_is_symlink "$temporary" || { die "temporary current link was not created"; return 1; }
  [ "$(read_symlink_target "$temporary")" = "$release" ] || { die "temporary current link target differs"; return 1; }
  [ "$(resolve_existing_path "$temporary")" = "$release" ] || { die "temporary current link resolves unexpectedly"; return 1; }
  set_link_owner "$temporary" || return $?
  echo "Current link replacement prepared: previous=${current_release:-none} target=$release"
  atomic_replace_path "$temporary" "$current_link" || return $?
  echo "Current link replacement executed: previous=${current_release:-none} target=$release"
  path_is_symlink "$current_link" || { die "current link switch did not publish a symlink"; return 1; }
  [ "$(read_symlink_target "$current_link")" = "$release" ] || { die "current link target differs after switch"; return 1; }
  [ "$(resolve_existing_path "$current_link")" = "$release" ] || { die "current link resolution differs after switch"; return 1; }
)

prepared_path=""
prepared_release=""
prepared_remote_head=""
prepared_reused=false
prepare_release() {
  local commit="$1"
  local ref="$2"
  local release
  local staging
  release="$(release_path_for "$commit")"
  prepared_release="$release"
  prepared_reused=false

  reject_prebuilt_legacy "$commit" || return $?

  if [ -e "$release" ] || path_is_symlink "$release"; then
    validate_release_directory "$release" "$commit" || return $?
    verify_staged_release "$release" "$commit" "$ref" || return $?
    prepared_path="$release"
    prepared_remote_head="$verified_remote_head"
    prepared_reused=true
    return 0
  fi

  staging="$release_root/.staging-$commit-$$"
  [ ! -e "$staging" ] && ! path_is_symlink "$staging" || { die "release preparation path collision"; return 1; }
  mkdir -m 0755 "$staging" || return $?
  prepared_path="$staging"
  set_file_owner "$staging" || return $?
  chmod 0755 "$staging" || return $?
  run_as_deploy_user git clone --no-checkout "$repository" "$staging" || return $?
  validate_preparation_directory "$staging" || return $?
  validate_origin "$staging" || return $?
  fetch_and_verify_reachability "$staging" "$commit" "$ref" || return $?
  git_in_release "$staging" checkout --detach "$commit" || return $?
  validate_git_state "$staging" "$commit" || return $?
  ensure_shared_links "$staging" || return $?
  validate_git_state "$staging" "$commit" || return $?
  prepared_path="$staging"
  prepared_remote_head="$fetched_remote_head"
}

refresh_prepared_remote_provenance() {
  local release="$1"
  local commit="$2"
  local ref="$3"
  fetch_and_verify_reachability "$release" "$commit" "$ref" || return $?
  prepared_remote_head="$fetched_remote_head"
}

publish_prepared_release() {
  local commit="$1"
  write_provenance "$prepared_path" "$commit" "$allowed_ref" "$prepared_remote_head"
  verify_build_artifact "$prepared_path" || return $?
  validate_git_state "$prepared_path" "$commit" || return $?
  if [ "$prepared_path" != "$prepared_release" ]; then
    [ ! -e "$prepared_release" ] && ! path_is_symlink "$prepared_release" || { die "release destination appeared during preparation"; return 1; }
    atomic_replace_path "$prepared_path" "$prepared_release" || return $?
    prepared_path="$prepared_release"
  fi
  verify_staged_release "$prepared_release" "$commit" "$allowed_ref" || return $?
}

target_commit=""
resolve_target_commit() {
  if [ -n "$requested_commit" ]; then
    target_commit="$requested_commit"
  else
    target_commit="$(remote_ref_head "$allowed_ref")" || return $?
  fi
  is_exact_commit "$target_commit" || { die "unable to resolve a valid deployment commit"; return 1; }
}

print_stage_dry_run() {
  local remote_head
  remote_head="$(remote_ref_head "$allowed_ref")" || return $?
  echo "Mode: stage-only (dry-run)"
  echo "Requested: $target_commit"
  echo "Allowed ref: $allowed_ref"
  echo "Allowed ref HEAD: $remote_head"
  echo "WOULD fetch the allowed ref, verify reachability, checkout, run checks, and build."
  echo "WOULD NOT back up or migrate the database."
  echo "WOULD NOT modify the production environment or content source."
  echo "WOULD NOT switch current."
  echo "WOULD NOT stop, start, restart, or reload the service."
}

print_activate_dry_run() {
  local release="$1"
  echo "Mode: activate-staged (dry-run)"
  echo "Requested: $target_commit"
  echo "Allowed ref: $allowed_ref"
  echo "WOULD verify staged release (read-only verification completed): $release"
  echo "WOULD switch current atomically to the verified staged release."
  echo "WOULD NOT install or build application dependencies."
  echo "WOULD NOT back up or migrate the database."
  echo "WOULD NOT modify the production environment or content source."
  echo "WOULD NOT stop, start, restart, or reload the service."
}

stage_only() (
  trap 'status=$?; if [ -n "$prepared_path" ] && [ "$prepared_path" != "$prepared_release" ]; then rm -rf -- "$prepared_path"; fi; exit "$status"' EXIT
  if [ "$dry_run" = true ]; then
    print_stage_dry_run || return $?
    return 0
  fi
  prepare_release "$target_commit" "$allowed_ref" || return $?
  if [ "$prepared_reused" = true ]; then
    echo "Already staged and verified: $target_commit"
    echo "Allowed ref: $allowed_ref"
    return 0
  fi
  run_release_static_checks "$prepared_path" || return $?
  run_release_build "$prepared_path" || return $?
  verify_build_artifact "$prepared_path" || return $?
  validate_git_state "$prepared_path" "$target_commit" || return $?
  publish_prepared_release "$target_commit" || return $?
  echo "Staged and verified: $target_commit"
  echo "Release: $prepared_release"
  echo "Allowed ref: $allowed_ref"
  echo "Current and service were not changed."
)

activate_staged() {
  local release
  local previous
  # Never create health evidence for a link-only operation. A terminal journal
  # permits only an idempotent operation on its already-confirmed current target.
  run_prebuilt_helper check-state --path "$activation_state" --current "$current_link" --target "$target_commit" || return $?
  reject_prebuilt_legacy "$target_commit" || return $?
  release="$(release_path_for "$target_commit")"
  verify_staged_release "$release" "$target_commit" "$allowed_ref" || return $?
  validate_current_link || return $?
  previous="$current_release"
  if [ "$current_release" = "$release" ]; then
    echo "Already current: $target_commit; journal unchanged; service health was not revalidated."
    return 0
  fi
  if [ "$dry_run" = true ]; then
    print_activate_dry_run "$release" || return $?
    return 0
  fi
  run_student_id_preflight || return $?
  atomic_switch_current "$release" || return $?
  echo "Activated staged release: $target_commit"
  echo "Previous: ${previous:-none}"
  echo "Service was not started or restarted."
}

full_deploy() (
  trap 'status=$?; if [ -n "$prepared_path" ] && [ "$prepared_path" != "$prepared_release" ]; then rm -rf -- "$prepared_path"; fi; activation_exit "$status"' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  local previous
  reject_prebuilt_legacy "$target_commit" || return $?
  validate_current_link || return $?
  previous="$current_release"
  if [ "$target_commit" = "$current_commit" ]; then
    echo "Already deployed: $target_commit"
    return 0
  fi
  if [ "$dry_run" = true ]; then
    echo "Mode: full deploy (dry-run)"
    echo "Would deploy: $target_commit"
    echo "Allowed ref: $allowed_ref"
    echo "Current: ${current_commit:-none}"
    echo "WOULD run legacy checks, DB backup, migration, build, current switch, restart, and health verification."
    return 0
  fi

  prepare_release "$target_commit" "$allowed_ref" || return $?
  if [ "$prepared_reused" = true ]; then
    refresh_prepared_remote_provenance "$prepared_path" "$target_commit" "$allowed_ref" || return $?
  fi
  run_student_id_preflight || return $?
  run_release_static_checks "$prepared_path" || return $?
  run_release_build "$prepared_path" || return $?
  verify_build_artifact "$prepared_path" || return $?
  validate_git_state "$prepared_path" "$target_commit" || return $?
  publish_prepared_release "$target_commit" || return $?
  [ -n "$previous" ] || { die "legacy activation requires an existing recovery release"; return 1; }
  validate_recovery_release "$previous" || return $?
  run_prebuilt_helper migration-ready --release "$prepared_release" --previous "$previous" --database "$shared/prisma/dev.db" || return $?
  run_db_backup || return $?
  activation_previous="$previous"
  activation_release="$prepared_release"
  activation_database_digest="$(run_prebuilt_helper database-fingerprint --database "$shared/prisma/dev.db")" || return $?
  [[ "$activation_database_digest" =~ ^[0-9a-f]{64}$ ]] || { die "missing pre-migration database proof"; return 1; }
  record_activation_phase PREPARED || return $?
  record_activation_phase SERVICE_STOPPING || return $?
  stop_service || return $?
  record_activation_phase SERVICE_STOPPED || return $?
  record_activation_phase MIGRATING || return $?
  run_migration "$prepared_release" || return $?
  run_prebuilt_helper migration-ready --release "$prepared_release" --previous "$previous" --database "$shared/prisma/dev.db" --complete || return $?
  record_activation_phase MIGRATED || return $?
  run_student_id_preflight || return $?
  record_activation_phase SWITCHING || return $?
  atomic_switch_current "$prepared_release" || return $?
  record_activation_phase SWITCHED || return $?
  restart_service || return $?
  wait_for_health || return $?
  record_activation_phase HEALTHY || return $?

  echo "Deployed: $target_commit"
  echo "Previous: ${current_commit:-none}"
)

prebuilt_receipt() {
  printf '%s/%s.json\n' "$prebuilt_state" "$1"
}

reject_prebuilt_legacy() {
  local receipt permit
  permit="$prebuilt_approvals/legacy-$1.json"
  verify_root_metadata "$permit" || return $?
  run_prebuilt_helper legacy --approval "$permit" --commit "$1" --allowed-ref "$allowed_ref" || return $?
  receipt="$(prebuilt_receipt "$1")"
  [ ! -e "$receipt" ] && ! path_is_symlink "$receipt" || { die "imported candidates require --activate-prebuilt and independent approval"; return 1; }
  [ ! -e "$(release_path_for "$1")/.git/nuaafa-prebuilt" ] || { die "prebuilt candidate cannot use legacy deployment modes"; return 1; }
}

verify_root_metadata() {
  local path="$1"
  [ "$(resolve_existing_path "$path")" = "$path" ] || { die "trusted metadata path must be canonical"; return 1; }
  while :; do
    ! path_is_symlink "$path" || { die "trusted metadata symlink"; return 1; }
    [ "$(stat -c '%u' "$path")" = 0 ] || { die "trusted metadata must be owned by root"; return 1; }
    local mode
    mode="$(stat -c '%a' "$path")" || return $?
    (( (8#$mode & 0022) == 0 )) || { die "trusted metadata is writable by non-root users"; return 1; }
    [ "$path" != / ] || break
    path="$(dirname -- "$path")" || return $?
  done
  return 0
}

prebuilt_phase() {
  local phase="$1"
  shift
  if [ "$prebuilt_timing" = true ]; then
    # Bash's builtin time preserves the command status and adds no timer process.
    # These inclusive spans may contain nested helper spans; do not sum them.
    local TIMEFORMAT="NUAAFA_PREBUILT_SHELL_TIMING {\"phase\":\"$phase\",\"elapsed_seconds\":%R,\"user_seconds\":%U,\"system_seconds\":%S}"
    time "$@"
  else
    "$@"
  fi
}

run_prebuilt_helper() {
  verify_root_metadata "$(resolve_existing_path "$prebuilt_python")" || return $?
  verify_root_metadata "$prebuilt_helper" || return $?
  [ -f "$prebuilt_helper" ] || { die "trusted helper must be a regular file"; return 1; }
  if [ "$prebuilt_timing" = true ]; then
    env -i PATH=/usr/bin:/bin "$prebuilt_python" -I "$prebuilt_helper" --timings "$@"
  else
    env -i PATH=/usr/bin:/bin "$prebuilt_python" -I "$prebuilt_helper" "$@"
  fi
}

verify_prebuilt_platform() {
  # Node is deliberately outside the archive. Never bundle/replace the host runtime.
  verify_root_metadata "$(resolve_existing_path "$student_id_preflight_node")" || return $?
  [ "$(env -i "$student_id_preflight_node" --version)" = "v22.23.4" ] || { die "prebuilt activation requires Node 22.23.4"; return 1; }
  run_prebuilt_helper platform --receipt "$(prebuilt_receipt "$target_commit")"
}

verify_prebuilt_release() {
  local release="$1" commit="$2" receipt checksum="${3:-$artifact_sha256}" ref="${4:-$allowed_ref}" purpose="${5:-candidate}"
  case "$purpose" in
    candidate) ;;
    recovery) ;;
    *) die "invalid prebuilt verification purpose"; return 1 ;;
  esac
  receipt="$(prebuilt_receipt "$commit")"
  verify_root_metadata "$receipt" || return $?
  validate_release_directory "$release" "$commit" || return $?
  validate_origin "$release" || return $?
  # A trimmed runtime intentionally omits tracked docs/ops/configuration. Its
  # contract is the commit-derived source set and the complete receipt inventory;
  # full-checkout cleanliness remains mandatory on every legacy path.
  local verification_args=(verify --release "$release" --receipt "$receipt" --sha256 "$checksum" --commit "$commit" --allowed-ref "$ref" --git-user "$deploy_user" --shared "$shared")
  if [ "$purpose" = recovery ]; then verification_args+=(--recovery); fi
  run_prebuilt_helper "${verification_args[@]}" || return $?
  verify_build_artifact "$release" || return $?
}

validate_recovery_release() (
  local release="$1" commit receipt identity checksum ref
  commit="$(basename -- "$release")"
  receipt="$(prebuilt_receipt "$commit")"
  if [ -e "$receipt" ] || path_is_symlink "$receipt" || [ -e "$release/.git/nuaafa-prebuilt" ]; then
    operation_mode=prebuilt
    verify_root_metadata "$receipt" || return $?
    identity="$(run_prebuilt_helper receipt-identity --receipt "$receipt")" || return $?
    checksum="$(printf '%s\n' "$identity" | sed -n '1p')"
    ref="$(printf '%s\n' "$identity" | sed -n '2p')"
    verify_prebuilt_release "$release" "$commit" "$checksum" "$ref" recovery || return $?
  else
    if [ "$operation_mode" = prebuilt ]; then
      die "prebuilt recovery requires a sealed release with its own verified receipt; legacy transition is not automatic"
      return 1
    fi
    # The separate legacy full-deploy mode retains its original service
    # contract. It cannot be used as a prebuilt transition or bypass this gate.
    operation_mode=full
    validate_release_directory "$release" "$commit" || return $?
    validate_origin "$release" || return $?
    validate_git_state "$release" "$commit" || return $?
    verify_build_artifact "$release" || return $?
  fi
  verify_shared_links "$release" || return $?
  run_prebuilt_helper shared-links --release "$release" --shared "$shared" --git-user "$deploy_user" || return $?
)

verify_recovery_startup() {
  [ "$operation_mode" = prebuilt ] || return 0
  # Execute only the root-controlled wrapper's read-only contract check as the
  # actual app UID. No candidate startup, environment load or service mutation.
  run_as_deploy_user env -i "$prebuilt_start" --check-release "$1" || {
    die "previous release cannot satisfy the actual startup contract"
    return 1
  }
}

import_artifact() (
  # A subshell gives failed imports an unconditional cleanup, even with errexit.
  local release receipt remote_head checkout_candidate staging_candidate
  work=""
  staging=""
  checkout=""
  release="$(release_path_for "$target_commit")"
  receipt="$(prebuilt_receipt "$target_commit")"
  [[ "$artifact_path" = /* ]] || { die "archive path must be absolute"; return 1; }
  validate_canonical_shared_file "$artifact_path" "input archive" || return $?
  verify_root_metadata "$(dirname -- "$prebuilt_state")" || return $?
  if [ -e "$prebuilt_state" ] || path_is_symlink "$prebuilt_state"; then
    validate_exact_directory "$prebuilt_state" "prebuilt receipt directory" || return $?
    verify_root_metadata "$prebuilt_state" || return $?
  fi
  work="$(mktemp -d "$(dirname -- "$prebuilt_state")/.prebuilt-import.XXXXXXXX")" || return $?
  trap 'status=$?; [ -z "$work" ] || rm -rf -- "$work"; [ -z "$staging" ] || rm -rf -- "$staging"; [ -z "$checkout" ] || rm -rf -- "$checkout"; exit "$status"' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  # Copy before inspecting; the copy is private to root and is the only input used.
  prebuilt_phase archive_snapshot run_prebuilt_helper snapshot --archive "$artifact_path" --sha256 "$artifact_sha256" --destination "$work/input.tar.gz" || return $?
  mkdir -m 0700 "$work/payload" || return $?
  prebuilt_phase archive_validate_extract run_prebuilt_helper extract --archive "$work/input.tar.gz" --sha256 "$artifact_sha256" --commit "$target_commit" --destination "$work/payload" || return $?
  checkout_candidate="$release_root/.prebuilt-source-$target_commit-$$"
  [ ! -e "$checkout_candidate" ] && ! path_is_symlink "$checkout_candidate" || { die "Git preparation collision"; return 1; }
  mkdir -m 0755 "$checkout_candidate" || return $?
  checkout="$checkout_candidate"
  set_file_owner "$checkout" || return $?
  chmod 0755 "$checkout" || return $?
  prebuilt_phase git_clone run_as_deploy_user git clone --no-hardlinks --no-checkout "$repository" "$checkout" || return $?
  prebuilt_phase git_origin validate_origin "$checkout" || return $?
  prebuilt_phase git_reachability fetch_and_verify_reachability "$checkout" "$target_commit" "$allowed_ref" || return $?
  remote_head="$fetched_remote_head"
  prebuilt_phase git_checkout git_in_release "$checkout" checkout --detach "$target_commit" || return $?
  prebuilt_phase git_state validate_git_state "$checkout" "$target_commit" || return $?
  if [ -e "$release" ] || path_is_symlink "$release"; then
    prebuilt_phase repeat_receipt_and_tree_verify verify_prebuilt_release "$release" "$target_commit" || return $?
    echo "Already imported and verified; current unchanged: $target_commit"
    return 0
  fi
  [ ! -e "$receipt" ] && ! path_is_symlink "$receipt" || { die "orphan receipt requires operator inspection"; return 1; }
  staging_candidate="$release_root/.prebuilt-$target_commit-$$"
  [ ! -e "$staging_candidate" ] && ! path_is_symlink "$staging_candidate" || { die "prebuilt staging collision"; return 1; }
  run_prebuilt_helper capacity --directory "$release_root" --manifest "$work/payload/nuaafa-artifact.json" || return $?
  prebuilt_phase materialize run_prebuilt_helper materialize --payload "$work/payload" --checkout "$checkout" --destination "$staging_candidate" --repository "$repository" --runtime-user "$deploy_user" || return $?
  staging="$staging_candidate"
  prebuilt_phase receipt_create "$prebuilt_python" -I - "$work/payload/nuaafa-artifact.json" "$work/receipt.json" "$target_commit" "$artifact_sha256" "$allowed_ref" "$remote_head" <<'PY' || return $?
import json, sys
with open(sys.argv[1]) as f: manifest = json.load(f)
with open(sys.argv[2], 'x') as f:
    json.dump(dict(format=1, commit=sys.argv[3], sha256=sys.argv[4], allowed_ref=sys.argv[5], remote_head=sys.argv[6], manifest=manifest), f, sort_keys=True)
PY
  # Root-private receipt is not taken from candidate code or a candidate checksum.
  prebuilt_phase receipt_and_tree_verify run_prebuilt_helper verify --release "$staging" --receipt "$work/receipt.json" --sha256 "$artifact_sha256" --commit "$target_commit" --allowed-ref "$allowed_ref" --git-user "$deploy_user" || return $?
  validate_origin "$staging" || return $?
  if [ "$dry_run" = true ]; then
    echo "Archive, trusted Git sources and runtime verified; WOULD import $target_commit; no published deployment state changed."
    return 0
  fi
  if [ ! -e "$prebuilt_state" ]; then mkdir -m 0700 "$prebuilt_state" || return $?; fi
  printf '%s\n' "$artifact_sha256" > "$staging/.git/nuaafa-prebuilt" || return $?
  chmod 0600 "$work/receipt.json" || return $?
  [ ! -e "$release" ] && ! path_is_symlink "$release" || { die "release destination collision"; return 1; }
  # Receipt first: a crash can only leave a blocked orphan, never an unmarked release.
  atomic_replace_path "$work/receipt.json" "$receipt" || return $?
  if ! atomic_replace_path "$staging" "$release"; then
    if ! rm -- "$receipt"; then echo "STOP: orphan receipt requires inspection" >&2; fi
    die "prebuilt publication failed"; return 1
  fi
  staging=""
  echo "Imported candidate: $target_commit; allowed ref HEAD: $remote_head"
  echo "Current, service, environment, uploads and database unchanged. Release approval still required."
)

activate_prebuilt() (
  local release previous approval
  release="$(release_path_for "$target_commit")"
  approval="$prebuilt_approvals/$target_commit.json"
  run_prebuilt_helper check-state --path "$activation_state" || return $?
  verify_prebuilt_release "$release" "$target_commit" || return $?
  run_prebuilt_helper approve --approval "$approval" --sha256 "$artifact_sha256" --commit "$target_commit" --allowed-ref "$allowed_ref" || return $?
  verify_prebuilt_platform || return $?
  validate_current_link || return $?
  previous="$current_release"
  [ -n "$previous" ] || { die "prebuilt activation requires an existing verified recovery release"; return 1; }
  verify_service_contract || return $?
  validate_recovery_release "$previous" || return $?
  verify_recovery_startup "$previous" || return $?
  if [ "$previous" = "$release" ]; then
    wait_for_health || { die "current candidate is unhealthy"; return 1; }
    echo "Already activated and healthy: $target_commit"
    return 0
  fi
  # Checks and migrations never fetch into the immutable runtime Git directory.
  activation_work="$(mktemp -d "$release_root/.reachability.XXXXXXXX")" || return $?
  trap 'status=$?; [ -z "$activation_work" ] || rm -rf -- "$activation_work"; activation_exit "$status"' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  set_file_owner "$activation_work" || return $?
  chmod 0755 "$activation_work" || return $?
  run_as_deploy_user git clone --no-hardlinks --no-checkout "$repository" "$activation_work" || return $?
  fetch_and_verify_reachability "$activation_work" "$target_commit" "$allowed_ref" || return $?
  run_student_id_preflight || return $?
  run_prebuilt_helper migration-ready --release "$release" --previous "$previous" --database "$shared/prisma/dev.db" || return $?
  if [ "$dry_run" = true ]; then
    echo "Verified approvals, service contract, reachability and migration compatibility; WOULD backup, stop, migrate, switch and verify health."
    return 0
  fi
  ensure_shared_links "$release" || return $?
  verify_prebuilt_release "$release" "$target_commit" || return $?
  run_as_deploy_user test -r "$shared/.env.production" || { die "application cannot read approved configuration"; return 1; }
  run_prebuilt_backup "$release" || return $?
  activation_previous="$previous"
  activation_release="$release"
  activation_database_digest="$(run_prebuilt_helper database-fingerprint --database "$shared/prisma/dev.db")" || return $?
  [[ "$activation_database_digest" =~ ^[0-9a-f]{64}$ ]] || { die "missing pre-migration database proof"; return 1; }
  record_activation_phase PREPARED || return $?
  record_activation_phase SERVICE_STOPPING || return $?
  stop_service || return $?
  record_activation_phase SERVICE_STOPPED || return $?
  record_activation_phase MIGRATING || return $?
  run_migration "$release" || return $?
  run_prebuilt_helper migration-ready --release "$release" --previous "$previous" --database "$shared/prisma/dev.db" --complete || return $?
  record_activation_phase MIGRATED || return $?
  run_student_id_preflight || return $?
  verify_prebuilt_release "$release" "$target_commit" || return $?
  run_prebuilt_helper approve --approval "$approval" --sha256 "$artifact_sha256" --commit "$target_commit" --allowed-ref "$allowed_ref" || return $?
  record_activation_phase SWITCHING || return $?
  atomic_switch_current "$release" || return $?
  record_activation_phase SWITCHED || return $?
  restart_service || return $?
  wait_for_health || return $?
  record_activation_phase HEALTHY || return $?
  echo "Activated approved prebuilt release: $target_commit; previous: $previous"
)

main() {
  parse_args "$@" || return $?
  if [ "$show_help" = true ]; then
    usage
    return 0
  fi
  if [ "$show_version" = true ]; then
    echo "nuaafa-deploy $deployer_version"
    return 0
  fi

  require_root || return $?
  prepare_process || return $?
  validate_fixed_configuration || return $?
  validate_allowed_ref "$allowed_ref" || return $?
  validate_layout_roots || return $?
  acquire_lock || return $?
  resolve_target_commit || return $?
  if [ "$operation_mode" != import ]; then
    run_prebuilt_helper check-state --path "$activation_state" --current "$current_link" || return $?
  fi

  case "$operation_mode" in
    stage)
      stage_only
      ;;
    activate)
      activate_staged
      ;;
    full)
      full_deploy
      ;;
    import)
      import_artifact
      ;;
    prebuilt)
      activate_prebuilt
      ;;
    *)
      die "unknown deployment mode"
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
