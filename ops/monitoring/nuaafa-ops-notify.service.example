[Unit]
Description=NUAAFA candidate notification sender (separate approval required)
After=network-online.target nuaafa-ops-collect.service
Wants=network-online.target nuaafa-ops-collect.service

[Service]
Type=oneshot
User=nuaafa-ops-notify
Group=nuaafa-ops-notify
UMask=0077
StateDirectory=nuaafa-ops-notify
StateDirectoryMode=0700
LoadCredential=config:/etc/nuaafa-monitoring/smtp.json
LoadCredential=relay-password:/etc/nuaafa-monitoring/relay-password
ExecStart=/usr/bin/python3 -I -B /usr/local/lib/nuaafa-monitoring/nuaafa_monitoring.py --state-dir /var/lib/nuaafa-ops-notify consume --handoff /var/lib/nuaafa-monitor-handoff --max-age-seconds 600
ExecStart=/usr/bin/python3 -I -B /usr/local/lib/nuaafa-monitoring/nuaafa_monitoring.py --state-dir /var/lib/nuaafa-ops-notify send --config %d/config
SupplementaryGroups=nuaafa-monitor-readers
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
InaccessiblePaths=/srv /var/log /var/lib/nuaafa-ops-monitor /etc/nuaafa /opt/nuaafa
ReadWritePaths=/var/lib/nuaafa-ops-notify
TimeoutStartSec=180
StandardOutput=journal
StandardError=journal

# No Install section: this template is not enabled by default.
# Consume detects stale/missing collector heartbeat and queues its own incident,
# returning0 to permit the final send even when the collector has failed.
# Final send returns2 for terminal/uncertain/stale delivery: real unit failure.
# Sender cannot read raw website logs/data; group grants handoff read only.
