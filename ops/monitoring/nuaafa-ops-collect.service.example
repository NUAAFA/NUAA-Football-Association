[Unit]
Description=NUAAFA candidate sanitized monitoring collector
Before=nuaafa-ops-notify.service

[Service]
Type=oneshot
User=root
Group=nuaafa-monitor-readers
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
UMask=0077
StateDirectory=nuaafa-ops-collect
StateDirectoryMode=0700
# Proposed thresholds/budgets only; must be explicitly approved before install.
ExecStart=/usr/bin/python3 -I -B /usr/local/lib/nuaafa-monitoring/nuaafa_monitoring.py --state-dir /var/lib/nuaafa-ops-collect fixed-bridge --handoff /var/lib/nuaafa-monitor-handoff --min-requests 20 --min-errors 5 --error-ratio 0.05 --max-handoff-bytes 8388608
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/lib/nuaafa-ops-collect /var/lib/nuaafa-monitor-handoff
InaccessiblePaths=/srv -/etc/nuaafa -/etc/nuaafa-monitoring -/var/lib/nuaafa-ops-notify -/run/credentials /root /home
TimeoutStartSec=90
StandardOutput=journal
StandardError=journal
# Root collector has DAC_READ_SEARCH only, fixed read-only sources, no network or
# SMTP credential visibility. There is no sudo rule or privilege escalation chain.
# No Install section: review candidate, not enabled.
